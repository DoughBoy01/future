{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "export-camps": "tsx scripts/export-camps-to-csv.ts",
    "test:webhook": "node test-webhook-diagnostic.mjs",
    "video:studio": "remotion studio src/remotion/index.ts",
    "video:render": "remotion render src/remotion/index.ts CampOwnerPromo out/camp-owner-promo.mp4",
    "video:preview": "remotion preview src/remotion/index.ts",
    "dev:api": "wrangler dev --port 8787",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply futureedge-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply futureedge-db --remote",
    "typecheck:api": "tsc -p worker/tsconfig.json",
    "deploy": "npm run build && wrangler deploy",
    "test:payments": "node worker/test/payments.mjs",
    "stripe:setup": "bash scripts/stripe.sh setup",
    "stripe:check": "bash scripts/stripe.sh check"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@remotion/cli": "^4.0.409",
    "@remotion/transitions": "^4.0.409",
    "@supabase/supabase-js": "^2.57.4",
    "@vapi-ai/web": "^2.5.0",
    "better-auth": "^1.7.7",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.3",
    "framer-motion": "^12.26.2",
    "hono": "^4.13.13",
    "i18next": "^25.6.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^16.2.3",
    "react-router-dom": "^7.9.3",
    "remotion": "^4.0.409",
    "resend": "^6.9.1",
    "stripe": "^23.0.0",
    "tsx": "^4.20.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@eslint/js": "^9.9.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "pg": "^8.16.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "wrangler": "^4.147.0"
  }
}
